# Copy to the CLASS ROOT as .env (one folder above Homework 4) OR into Homework 4/.env
# The backend loads the class-root .env first, then a local Homework 4/.env.

# Portkey gateway key (used for the PydanticAI agent's OpenAI calls)
PORTKEY_API_KEY=your-portkey-key-here

# Optional overrides (sensible defaults are built in):
# PORTKEY_BASE_URL=https://api.portkey.ai/v1
# PORTKEY_PROVIDER=openai
# CAMPUS_CHAT_MODEL=5.6luna
# CAMPUS_JWT_SECRET=change-me-to-a-long-random-string
# CAMPUS_DB_PATH=../data/campus_customs.db
# CAMPUS_PRODUCTS_DIR=../data/products
